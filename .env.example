# Public profile values. These are safe to expose in the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_BOOKING_URL=

# Email delivery for contact and recommendations. Never prefix secrets NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=

# Optional AI. Leave BOTH empty for free built-in portfolio answers.
# Choose a currently supported free-tier model in your Google AI Studio project.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional GitHub identity for recommendations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=
